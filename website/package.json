{
    "name": "website",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "format": "prettier --ignore-path \"../.gitignore\" --write \"./**/*.{ts,tsx,json,md,mdx,mjs,cjs,js,jsx,html}\"",
        "check-lint": "eslint .",
        "check-types": "tsc --noEmit",
        "check-format": "prettier --ignore-path \"../.gitignore\" --check \"./**/*.{ts,tsx,json,md,mdx,mjs,cjs,js,jsx,html}\""
    },
    "dependencies": {
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@iconify-json/emojione-monotone": "1.2.1",
        "@iconify-json/fluent-emoji-high-contrast": "1.2.6",
        "@iconify-json/game-icons": "1.2.4",
        "@iconify-json/mdi": "1.2.3",
        "@iconify/tailwind": "1.2.0",
        "@tailwindcss/postcss": "4.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react-swc": "4.3.3",
        "daisyui": "5.7.36",
        "eslint": "10.10.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.6",
        "globals": "17.12.0",
        "postcss": "8.5.28",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0",
        "vite": "8.3.0"
    }
}
